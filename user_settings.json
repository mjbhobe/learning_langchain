{
    "editor.fontFamily": "\"The Sans Mono-\", Consolas, \"Bitstream Vera Sans Mono\", \"DejaVu Sans Mono\",  \"SF Mono\", Consolas, monospace",
    "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
    //"editor.fontLigatures": "'ss04', 'ss05', 'calt'",
    // Start -> different fonts for different file types ----------------
    // 1. C/C++ Files: Krypton (Mechanical & Square)
    // "[cpp]": {
    //     "editor.fontFamily": "'Monaspace Krypton NF', monospace",
    //     "editor.fontLigatures": "'ss01', 'ss02', 'calt', 'dlig'"
    // },
    // "[c]": {
    //     "editor.fontFamily": "'Monaspace Krypton NF', monospace"
    // },
    // // 2. Python Files: Argon (Humanist & Breezy)
    // "[python]": {
    //     "editor.fontFamily": "'Monaspace Xenon NF', monospace",
    //     "editor.fontLigatures": "'ss04', 'ss05', 'calt'"
    // },
    // // 3. Notebooks: Radon (Handwriting/Cursive feel)
    // // This affects the CODE cells inside the notebook
    // "notebook.editorOptionsCustomizations": {
    //     "editor.fontFamily": "'Monaspace Xenon NF', monospace"
    // },
    // This affects the OUTPUT cells (like your print statements)
    // "notebook.output.fontFamily": "'Monaspace Krypton NF', monospace",
    // End -> different fonts for different file types ------------------
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.fontWeight": 400,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.suggestSelection": "first",
    "editor.lineHeight": 1.75,
    "editor.bracketPairColorization.enabled": false,
    "editor.codeActionsOnSave": {},
    //"editor.fontLigatures": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.minimap.enabled": false,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
        "*.csv": "gc-excelviewer-csv-editor"
    },
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    "vim.easymotion": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": false,
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-s>": false,
        "<C-c>": false,
        "<C-v>": false,
        "<C-x>": false
    },
    // this helps us use Ctrl+j instead of <Esc> on AVD
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "<C-j>" // The key combination you press
            ],
            "after": [
                "<Esc>" // The action Vim should perform (exit mode)
            ]
        }
    ],
    "terminal.integrated.cwd": "${fileDirname}",
    "python.condaPath": "\"C:\\Users\\BHOBEMRMANISHJAGDISH\\Dev\\anaconda3\\Scripts\\conda.exe\"",
    "editor.tokenColorCustomizations": {
        "[IntelliJ Neo Dark]": {
            "variables": "#aaaaaa",
            "textMateRules": [
                {
                    "scope": "entity.name.type.class",
                    "settings": {
                        "foreground": "#b48ead"
                    }
                },
            ]
        },
        "[JetBrains Rider Dark*]": {
            "textMateRules": [
                {
                    "scope": "string.quoted.multi.python",
                    "settings": {
                        "foreground": "#C8A16D"
                    }
                },
                {
                    "scope": "string.quoted.docstring.multi.python",
                    "settings": {
                        "foreground": "#6F737A"
                    }
                },
            ]
        },
        "[JetBrains Rider Dark Theme]": {
            "functions": "#85C46C",
            "comments": "#6F737A",
            "numbers": "#2aacb8",
            // "string.quoted.docstring.multi.python"
            "textMateRules": [
                {
                    "scope": "string.quoted.docstring.multi.python",
                    "settings": {
                        "foreground": "#C8A16D" //"#6F737A"
                    }
                },
            ],
        },
        "[*JetBrains New Dark*]": {
            "strings": "#6AAB73",
            "keywords": "#ce9178", //"#AA9BF5",
            "functions": "#6CB6FF", // "#EBC88D",
            "numbers": "#2aacb8",
            "variables": "#aaaaaa",
            "comments": "#6F737A",
            "textMateRules": [
                {
                    "scope": "entity.name.type.class",
                    "settings": {
                        "foreground": "#C77DBB"
                    }
                },
                {
                    "scope": "entity.name.type.enum",
                    "settings": {
                        "foreground": "#b48ead"
                    }
                },
                {
                    "scope": "variable.other.enummember",
                    "settings": {
                        "foreground": "#b48ead"
                    }
                },
                {
                    "scope": "variable.other.constant",
                    "settings": {
                        "foreground": "#b48ead"
                    }
                },
                {
                    "scope": "entity.name.namespace",
                    "settings": {
                        "foreground": "#aaaaaa"
                    }
                },
                {
                    "scope": "variable.parameter.function.language.special.self.python",
                    "settings": {
                        "foreground": "#8888c6"
                    }
                },
                {
                    "scope": "entity.name.function.member",
                    "settings": {
                        "foreground": "#aaaaaa"
                    }
                }
            ]
        },
        "[*JetBrains New UI*]": {
            "strings": "#6AAB73",
            "keywords": "#ce9178",
            "functions": "#6CB6FF",
            "numbers": "#2aacb8",
            "variables": "#aaaaaa",
            "textMateRules": [
                {
                    "scope": "entity.name.type.class",
                    "settings": {
                        "foreground": "#C77DBB"
                    }
                },
                {
                    "scope": "entity.name.type.enum",
                    "settings": {
                        "foreground": "#b48ead"
                    }
                },
                {
                    "scope": "variable.other.enummember",
                    "settings": {
                        "foreground": "#b48ead"
                    }
                },
                {
                    "scope": "variable.other.constant",
                    "settings": {
                        "foreground": "#b48ead"
                    }
                },
                {
                    "scope": "entity.name.namespace",
                    "settings": {
                        "foreground": "#aaaaaa"
                    }
                },
                {
                    "scope": "variable.parameter.function.language.special.self.python",
                    "settings": {
                        "foreground": "#8888c6"
                    }
                },
                {
                    "scope": "entity.name.function.member",
                    "settings": {
                        "foreground": "#aaaaaa"
                    }
                },
                {
                    "scope": "entity.other.inherited-class.python",
                    "settings": {
                        "foreground": "#C77DBB"
                    }
                },
            ]
        },
        "[Dark (Visual Studio)]": {
            "variables": "#aaaaaa"
        },
        "[*One Dark*]": {
            "variables": "#BCBEC4",
            "keywords": "#BB9AF7",
            "strings": "#9ECE68",
            "functions": "#7AA2F7"
        }
    },
    "security.workspace.trust.untrustedFiles": "open",
    "python.languageServer": "None",
    "debug.console.fontSize": 13.5,
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "clang-format.executable": "C:\\Dev\\Qt\\Tools\\QtCreator\\bin\\clang\\bin\\clang-format.exe",
    "settingsSync.ignoredSettings": [
        "editor.fontSize"
    ],
    "qt-core.qtInstallationRoot": "C:\\Dev\\Qt",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.inheritEnv": true,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-bash"
        },
        "Anaconda Shell": {
            "path": [
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [
                "/K",
                "C:\\Users\\BHOBEMRMANISHJAGDISH\\Dev\\anaconda3\\Scripts\\activate.bat",
                "C:\\Users\\BHOBEMRMANISHJAGDISH\\Dev\\anaconda3"
            ],
            "icon": "terminal-bash"
        }
    },
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "rsp-ui.enableStartServerOnActivation": [
        {
            "id": "redhat.vscode-community-server-connector",
            "name": "Community Server Connector",
            "startOnActivation": true
        }
    ],
    "terminal.external.windowsExec": "%windir%\\System32\\cmd.exe",
    //"python.defaultInterpreterPath": "C:\\Users\\BHOBEMRMANISHJAGDISH\\Dev\\anaconda3\\python.exe",
    "terminal.integrated.enablePersistentSessions": false,
    "git.autofetch": true,
    "workbench.colorTheme": "JetBrains New Dark",
    // Start -> Notebook specific settings notebook.XXXXX --------------------
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "notebook.insertToolbarLocation": "notebookToolbar",
    "notebook.formatOnCellExecution": true,
    "notebook.output.wordWrap": true,
    "notebook.output.textLineLimit": 100,
    "notebook.formatOnSave.enabled": true,
    "notebook.lineNumbers": "on",
    "notebook.output.fontFamily": "Consolas, Calibri, 'Fira Code', 'DejaVu Sans Mono', monospace",
    "notebook.output.fontSize": 14,
    "markdown.preview.fontFamily": "Segoe UI, Arial, sans-serif",
    "markdown.preview.fontSize": 15
    // End -> Notebook specific customizations
    "vscode-office.openOutline": true,
    "vscode-office.editorTheme": "Warm Light",
